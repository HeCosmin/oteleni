# Copy this file to .env and change the values. Keep .env private.
PORT=3000
OMDB_API_KEY=""
FILELIST_USERNAME=""
FILELIST_PASSKEY=""
FILELIST_CATEGORIES=""
OMDB_LANGUAGE="en"
API_CACHE_MINUTES=15
RESULT_LIMIT=20
ENABLE_FILELIST=true
ENABLE_OMDB=true
SUBTITLE_LANGUAGE="ru"
SUBTITLE_SOURCE_LANGUAGE="auto"
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""
ENABLE_SUBTITLE_TRANSLATION=true
# Local media root on Windows. Creates Movie and Series folders automatically.
MEDIA_ROOT=E:\\cinewave-website
STREAM_THRESHOLD=5

# qBittorrent Web API; keep the Web UI bound to 127.0.0.1 and never port-forward 8080
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Per-torrent save paths are set automatically to Movie/<release-name> or Series/<release-name>.
